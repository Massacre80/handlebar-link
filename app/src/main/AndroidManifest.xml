<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The ride service (ride/RideService): a connectedDevice foreground service (FGS-TYPES).
         BLUETOOTH_CONNECT comes from :bike:link-android. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Mute microphone from the handlebar during a call (controls/CarPlayControls): AudioService needs this for
         AudioManager.setMicrophoneMute; a normal (install-time) permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The ride and problem notifications; a runtime permission from Android 13 (request flow: M3.3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- What a handlebar press did, shown over CarPlay (Display over other apps, allowed by the rider). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Screen brightness from the handlebar (a special access the rider allows: Modify system settings). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- First-time setup (docs/PLAN.md): our own scan for the meter; the app never derives a location from
         it, so neverForLocation (bt-permissions: some beacons are then filtered, never the meter). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Location only for CarPlay's Wi-Fi Direct group on Android 12/12L (carplay/CarPlayPermissions; API 33+ uses
         NEARBY_WIFI_DEVICES below): precise and approximate asked together, as the location-permissions guide asks.
         maxSdkVersion 32, as the wifi-permissions guide allows when nothing else relies on precise location: ride
         logging, which did, was dropped (owner, 2026-11-20); our scans assert neverForLocation and companion-device
         pairing needs no location permission (bt-permissions). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- Our own CarPlay receiver (carplay/, docs/PLAN.md "CarPlay receiver", permissions table decided
         2026-11-19). It runs in RideService under the same connectedDevice type: CHANGE_WIFI_STATE alone meets
         that type's runtime prerequisite, and BLUETOOTH_CONNECT does too (FGS service types), so no type changes.
         BLUETOOTH_CONNECT: the RFCOMM dial to the iPhone (also declared by :bike:link-android for the meter).
         NEARBY_WIFI_DEVICES: the Wi-Fi Direct group on API 33+; nothing is located with it, so neverForLocation
         (API 31-32 use ACCESS_FINE_LOCATION, asked with ACCESS_COARSE_LOCATION, both declared above up to API 32). ACCESS_LOCAL_NETWORK: Android 17 blocks the local
         network for apps targeting SDK 37 without it (local-network-permission guide); unknown, so ignored,
         before. INTERNET: Android requires it for every socket, also the local ones to the iPhone; the Poco has
         no internet connection of its own. ACCESS_WIFI_STATE and CHANGE_WIFI_STATE: Wi-Fi Direct (wifi-direct
         guide). The runtime ones are asked for in the app's permission flow (Permissions page, Allow all, the
         CarPlay page's Start CarPlay). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- CarPlay's microphone for Siri and calls (C5): asked with CarPlay's other runtime permissions. RideService adds
         the microphone foreground type while CarPlay runs, from the moment the app is visible with CarPlay connected,
         so recording goes on with the screen off (FGS types: Microphone, runtime prerequisite RECORD_AUDIO; a
         while-in-use type, never added from the background: ride/ServiceTypes.kt keepsMicrophone). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Linking the meter through Android's companion-device consent (companion-device-pairing). -->
    <uses-feature android:name="android.software.companion_device_setup" />
    <!-- Auto-start on ignition (docs/PLAN.md M4): Android watches for the linked meter and binds
         autostart/BikePresenceService when it comes and goes (startObservingDevicePresence requires this
         permission). From that callback the ride service starts in the background: CDM apps holding
         REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND are exempt from the background-start
         restriction (FGS-RESTRICTIONS-BG-START). REQUEST_COMPANION_RUN_IN_BACKGROUND, with presence
         observing, is the BLE background guide's way to stay connected while the device is present. All
         three are normal (install-time) permissions. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />

    <!-- No backup: the app stores only the paired bike and settings, and a restored bond would be stale. -->
    <!-- Package visibility: the intercom maker's app, opened from the Intercom page. -->
    <queries>
        <package android:name="com.ejeas.ejeasapp" />
        <!-- Who gets a headset's assistant button now (the Devices page says so). -->
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
    </queries>

    <application
        android:name=".HandlebarLinkApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HandlebarLink">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only this app starts it, with explicit intents (android-intent-security). -->
        <service
            android:name=".ride.RideService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- Android binds it when the linked meter comes or goes (CompanionDeviceService reference: exported,
             guarded by BIND_COMPANION_DEVICE_SERVICE, which only the system holds). -->
        <service
            android:name=".autostart.BikePresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- After an update the ride starts again (autostart/AppUpdated). MY_PACKAGE_REPLACED is sent by the
             system to this app only, so the receiver is not exported. -->
        <receiver
            android:name=".autostart.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A headset's assistant button (HFP AT+BVRA makes Android start ACTION_VOICE_COMMAND): does what the
             rider chose and closes, nothing on screen, also over the lock screen while riding. Exported for
             the system; only that action is acted on. -->
        <activity
            android:name=".devices.AssistantButtonActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Headset connection changes wake the app (an implicit-broadcast exception), so a headset's battery
             report right after it connects is heard; on disconnect its stored level is forgotten. Exported for
             the Bluetooth app's broadcast; the action is protected (system only) and the sender must hold
             BLUETOOTH_CONNECT. -->
        <receiver
            android:name=".devices.HeadsetConnectionReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
